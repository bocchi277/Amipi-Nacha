# AMIPI NACHA ACH Payment System — Environment Variables Example
PROJECT_NAME="AMIPI NACHA ACH Payment System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL Async + Sync)
DATABASE_URL="postgresql+asyncpg://amipi:amipipass@localhost:5432/amipi_ach"
SYNC_DATABASE_URL="postgresql+psycopg2://amipi:amipipass@localhost:5432/amipi_ach"

# Security Configuration
SECRET_KEY="CHANGE_THIS_SECRET_KEY_FOR_PRODUCTION_USE_MIN_32_CHARS"

# Bank detail encryption at rest. REQUIRED - the app refuses to start without it.
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
BANK_DETAILS_ENCRYPTION_KEY="CHANGE_THIS_GENERATE_A_RANDOM_48_BYTE_URLSAFE_VALUE"
# Decrypt-only keys, comma separated. Only needed while rotating: put the OLD key here,
# run scripts/rotate_encryption_key.py, then remove it.
# BANK_DETAILS_ENCRYPTION_KEY_FALLBACKS=""
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SMTP / Email Configuration (Optional for Remittance Emails)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@amipi.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_NAME="AMIPI Accounts Payable"
